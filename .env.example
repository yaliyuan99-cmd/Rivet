# Copy to .env; the server reads it on start. All optional. With nothing set, Rivet runs fully on this machine with a SQLite database,
# a local upload folder, a /dev/outbox page instead of email, and the synthetic demo adapter.

# --- Server ---
# RIVET_PORT=8787
# RIVET_DATA_DIR=./data
# Public URL used in email links and OAuth redirects.
# RIVET_PUBLIC_URL=http://localhost:5173
# Set to 0 to run without the synthetic demo seed and labels.
# RIVET_DEMO=1
# Delay between run stages for the demo adapter, in milliseconds.
# RIVET_STAGE_MS=2500

# --- Email (without a key, messages go to the /dev/outbox page, non-production only) ---
# To keep the outbox under `npm start` on your own machine:
# RIVET_ALLOW_DEV_OUTBOX=1
# RESEND_API_KEY=
# RIVET_MAIL_FROM=Rivet <no-reply@your-domain.example>

# --- AI provider (real model runs, LLM judge and LLM Advisor mode) ---
# ANTHROPIC_API_KEY=

# --- Sign in with GitHub and connected profiles ---
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# HUGGINGFACE_CLIENT_ID=
# HUGGINGFACE_CLIENT_SECRET=
